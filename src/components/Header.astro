---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
const links = [
	{ href: '/#work', label: 'Work' },
	{ href: '/case-studies', label: 'Case studies' },
	{ href: '/about', label: 'About' },
];
---

<header class="site-header">
	<div class="wrap nav">
		<a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>
			<span class="brand-mark" aria-hidden="true">NP</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<nav class="nav-links" aria-label="Main">
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>

		<div class="nav-actions">
			<ThemeToggle />
			<a href="mailto:hello@nikhilpradhan.in" class="btn btn-sm nav-cta">Get in touch <span aria-hidden="true">↗</span></a>
			<button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<span></span><span></span>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="mobile-menu" hidden>
		<div class="wrap">
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
			<a href="mailto:hello@nikhilpradhan.in" class="btn">Get in touch ↗</a>
		</div>
	</div>
</header>

<script>
	const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
	const menu = document.getElementById('mobile-menu');
	if (btn && menu) {
		const set = (open: boolean) => {
			menu.hidden = !open;
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		};
		btn.addEventListener('click', () => set(menu.hidden));
		menu.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) set(false);
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 86%, transparent);
		backdrop-filter: saturate(1.2) blur(12px);
		-webkit-backdrop-filter: saturate(1.2) blur(12px);
		border-bottom: 1px solid color-mix(in srgb, var(--rule) 60%, transparent);
	}
	.nav {
		height: 72px;
		display: flex;
		align-items: center;
		gap: 24px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 750;
		letter-spacing: -0.03em;
		font-size: 17px;
		margin-right: auto;
	}
	.brand-mark {
		width: 30px;
		height: 30px;
		border-radius: 8px;
		display: grid;
		place-items: center;
		background: var(--ink);
		color: var(--accent-fill);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.nav-links {
		display: flex;
		gap: 28px;
		font-size: 14px;
		font-weight: 550;
	}
	.nav-links a {
		color: var(--ink-soft);
		transition: color 0.2s;
	}
	.nav-links a:hover {
		color: var(--ink);
	}
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.menu-btn {
		display: none;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid var(--rule);
		background: transparent;
		cursor: pointer;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
	}
	.menu-btn span {
		width: 16px;
		height: 1.5px;
		background: var(--ink);
		border-radius: 2px;
	}
	.mobile-menu {
		border-top: 1px solid var(--rule);
		background: var(--bg);
	}
	.mobile-menu .wrap {
		display: flex;
		flex-direction: column;
		padding-block: 12px 24px;
	}
	.mobile-menu a:not(.btn) {
		padding: 14px 0;
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.03em;
		border-bottom: 1px solid var(--rule-soft);
	}
	.mobile-menu .btn {
		margin-top: 20px;
	}
	@media (max-width: 900px) {
		.nav-links,
		.nav-cta {
			display: none;
		}
		.menu-btn {
			display: inline-flex;
		}
	}
</style>
