---
const today = new Date();
---

<footer class="site-footer">
	<div class="wrap footer-inner">
		<div class="footer-brand">
			<span class="brand-mark" aria-hidden="true">NP</span>
			<span>© {today.getFullYear()} Nikhil Pradhan · Sikkim → Liège</span>
		</div>
		<nav class="footer-links" aria-label="Footer">
			<a href="/rss.xml">RSS</a>
			<a href="https://www.linkedin.com/in/nikhil-jabez-pradhan/" target="_blank" rel="noopener">LinkedIn</a>
			<a href="/cv.pdf">CV</a>
			<a href="mailto:hello@nikhilpradhan.in">Email</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--rule);
		padding: 36px 0 48px;
	}
	.footer-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		font-size: 14px;
		color: var(--ink-soft);
	}
	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}
	.brand-mark {
		width: 26px;
		height: 26px;
		border-radius: 7px;
		display: grid;
		place-items: center;
		background: var(--ink);
		color: var(--accent-fill);
		font-size: 11px;
		font-weight: 800;
	}
	.footer-links {
		display: flex;
		gap: 22px;
		font-weight: 550;
	}
	.footer-links a:hover {
		color: var(--ink);
	}
</style>
