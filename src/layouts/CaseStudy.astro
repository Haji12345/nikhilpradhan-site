---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { CaseStudy } from '../lib/work';

interface Props {
	entry: CaseStudy;
	next: CaseStudy | null;
}

const { entry, next } = Astro.props;
const {
	title,
	summary,
	role,
	organisation,
	period,
	location,
	themes,
	stakeholders,
	metrics,
	heroImage,
	heroAlt,
	heroCaption,
	draft,
} = entry.data;

const facts = [
	{ label: 'Role', value: role },
	{ label: 'Organisation', value: organisation },
	{ label: 'Period', value: period },
	location ? { label: 'Location', value: location } : null,
	stakeholders.length ? { label: 'Worked with', value: stakeholders.join(' · ') } : null,
].filter((f): f is { label: string; value: string } => f !== null);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} — Case study`} description={summary} />
	</head>
	<body>
		<Header />

		<main>
			<article class="case-study">
				<div class="wrap wrap-narrow">
					{
						draft && (
							<p class="draft-banner">
								Draft — visible only in <code>npm run dev</code>. Set <code>draft: false</code> to
								publish.
							</p>
						)
					}

					<header class="cs-header">
						<a href="/case-studies" class="back-link">← All case studies</a>
						<div class="cs-eyebrow">{organisation} · {period}</div>
						<h1 class="cs-title">{title}</h1>
						<p class="cs-summary">{summary}</p>
						{
							themes.length > 0 && (
								<ul class="cs-themes" aria-label="Themes">
									{themes.map((t) => (
										<li>{t}</li>
									))}
								</ul>
							)
						}
					</header>

					<dl class="cs-facts">
						{
							facts.map((f) => (
								<div class="cs-fact">
									<dt>{f.label}</dt>
									<dd>{f.value}</dd>
								</div>
							))
						}
					</dl>

					{
						metrics.length > 0 && (
							<section class="cs-metrics" aria-label="Key numbers">
								{metrics.map((m) => (
									<div class="cs-metric">
										<strong>{m.value}</strong>
										<span>{m.label}</span>
									</div>
								))}
							</section>
						)
					}
				</div>

				{
					heroImage && (
						<figure class="cs-hero">
							<div class="wrap wrap-narrow">
								<Image
									src={heroImage}
									alt={heroAlt ?? ''}
									width={1200}
									class="cs-hero-img"
								/>
								{heroCaption && <figcaption>{heroCaption}</figcaption>}
							</div>
						</figure>
					)
				}

				<div class="wrap wrap-narrow">
					<div class="prose cs-body">
						<slot />
					</div>

					<footer class="cs-footer">
						{
							next ? (
								<a href={`/work/${next.id}/`} class="cs-next">
									<span>Next case study</span>
									<strong>{next.data.title}</strong>
								</a>
							) : (
								<a href="/case-studies" class="cs-next">
									<span>Back to</span>
									<strong>All case studies</strong>
								</a>
							)
						}
						<p class="cs-contact">
							Want the longer version of this story?{' '}
							<a href="mailto:hello@nikhilpradhan.in">hello@nikhilpradhan.in</a>
						</p>
					</footer>
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.draft-banner {
		margin-top: 32px;
		padding: 10px 14px;
		font-family: var(--font-mono), monospace;
		font-size: 12px;
		color: var(--ink-soft);
		border: 1px dashed var(--accent);
		border-radius: var(--radius-md);
		background: var(--bg-elev);
	}
	.draft-banner code {
		font-size: 12px;
	}
	.cs-header {
		padding: 56px 0 32px;
	}
	.back-link {
		font-family: var(--font-mono), monospace;
		font-size: 12px;
		color: var(--ink-faint);
		letter-spacing: 0.05em;
		margin-bottom: 32px;
		display: inline-block;
		transition: color 0.2s;
	}
	.back-link:hover {
		color: var(--accent);
		opacity: 1;
	}
	.cs-eyebrow {
		font-family: var(--font-mono), monospace;
		font-size: 11px;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 18px;
	}
	.cs-title {
		font-family: var(--font-serif), Georgia, serif;
		font-weight: 720;
		font-size: clamp(32px, 5vw, 48px);
		letter-spacing: -0.045em;
		line-height: 1.1;
		color: var(--ink);
		margin-bottom: 20px;
	}
	.cs-summary {
		font-family: var(--font-serif), Georgia, serif;
		font-size: 20px;
		line-height: 1.5;
		color: var(--ink-soft);
		max-width: 600px;
	}
	.cs-themes {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 24px;
	}
	.cs-themes li {
		font-family: var(--font-mono), monospace;
		font-size: 11px;
		letter-spacing: 0.04em;
		color: var(--ink-soft);
		border: 1px solid var(--rule);
		border-radius: 999px;
		padding: 3px 10px;
	}
	.cs-facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 20px 28px;
		padding: 24px 0;
		border-top: 1px solid var(--rule);
	}
	.cs-fact dt {
		font-family: var(--font-mono), monospace;
		font-size: 10px;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--ink-faint);
		margin-bottom: 4px;
	}
	.cs-fact dd {
		font-family: var(--font-sans), sans-serif;
		font-size: 14px;
		line-height: 1.4;
		color: var(--ink);
	}
	.cs-metrics {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
		gap: 20px;
		padding: 24px 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.cs-metric {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.cs-metric strong {
		font-family: var(--font-serif), Georgia, serif;
		font-size: 26px;
		font-weight: 720;
		line-height: 1;
		color: var(--ink);
	}
	.cs-metric span {
		font-family: var(--font-mono), monospace;
		font-size: 11px;
		line-height: 1.3;
		color: var(--ink-faint);
	}
	.cs-hero {
		margin: 40px 0 8px;
	}
	.cs-hero-img {
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		border: 1px solid var(--rule);
	}
	.cs-hero figcaption {
		font-family: var(--font-serif), Georgia, serif;
		font-size: 15px;
		color: var(--ink-faint);
		margin-top: 10px;
	}
	.cs-body {
		padding-top: 48px;
	}
	.cs-footer {
		max-width: 640px;
		margin: 48px auto 0;
		padding-top: 32px;
		border-top: 1px solid var(--rule);
	}
	.cs-next {
		display: flex;
		flex-direction: column;
		gap: 6px;
		color: var(--ink);
	}
	.cs-next span {
		font-family: var(--font-mono), monospace;
		font-size: 11px;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.cs-next strong {
		font-family: var(--font-serif), Georgia, serif;
		font-size: 24px;
		font-weight: 720;
		transition: color 0.2s;
	}
	.cs-next:hover {
		opacity: 1;
	}
	.cs-next:hover strong {
		color: var(--accent);
	}
	.cs-contact {
		margin-top: 28px;
		font-family: var(--font-sans), sans-serif;
		font-size: 14px;
		color: var(--ink-soft);
	}
	.cs-contact a {
		border-bottom: 1px solid var(--accent);
	}
	@media (max-width: 640px) {
		.cs-header {
			padding: 40px 0 24px;
		}
		.cs-summary {
			font-size: 18px;
		}
	}
</style>
