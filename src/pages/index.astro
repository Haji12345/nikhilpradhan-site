---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCaseStudies, getTourismProjects } from '../lib/work';
import heroImage from '../assets/sikkim-hero.jpg';
import MediaCarousel from '../components/tourism/MediaCarousel.astro';
import honeycomb from '../assets/photos/apicare-honeycomb.jpg';
import apicareLogo from '../assets/photos/apicare/apicare-logo.jpg';
import apicareFilm from '../assets/photos/apicare/film-poster.jpg';
import farmledgerMark from '../assets/photos/farmledger/farmledger-mark.jpg';
import istriaHilltop from '../assets/photos/porec/istria-hilltop-town-poster.jpg';
import kengbariFreshAir from '../assets/photos/kengbari/fresh-air-poster.jpg';
import greenHamletAerial from '../assets/photos/green-hamlet/aerial.jpg';
import kunjhamPool from '../assets/photos/kunjham/pool-from-above.jpg';

// Feature the strongest published case study on the homepage.
const caseStudies = (await getCaseStudies())
	.filter((entry) => entry.data.featured)
	.slice(0, 1);

const tourismCount = (await getTourismProjects()).length;

const stats = [
	{ value: '125+', label: 'Smallholder farmers' },
	{ value: '3', label: 'Himalayan districts' },
	{ value: '5 yrs', label: 'Operating ApiCare' },
	{ value: '0', label: 'KPMG audit findings, 3 cycles' },
	{ value: '5', label: 'RAMP training sites, 2026–27' },
];

const ventures = [
	{
		href: 'https://www.apicare.co.in',
		external: true,
		tag: 'Operating · 2021 →',
		name: 'ApiCare',
		desc: 'Agri-tech venture in Sikkim, selected by the Government of Sikkim as a private-sector partner under RAMP — a World Bank-financed MSME programme. Honey production with smallholder beekeepers. Zero KPMG findings across three audit cycles.',
		stats: ['Govt of Sikkim RAMP partner', '104 trained under RAMP', '125+ farmer network'],
		links: [
			{ href: 'https://www.apicare.co.in', label: 'apicare.co.in' },
			{ href: 'https://www.instagram.com/apicare/', label: '@apicare', instagram: true },
		],
		media: [
			{ type: 'video' as const, src: '/video/apicare-film.mp4', poster: apicareFilm, alt: 'ApiCare film: harvesting comb honey and the bottled Himalayan Forest Honey at a market stall' },
			{ type: 'image' as const, src: honeycomb, alt: 'Wild honeycomb resting on moss in Sikkim' },
			{ type: 'image' as const, src: apicareLogo, alt: 'ApiCare logo: Taste the Essence of the Himalayas' },
		],
	},
	{
		href: 'https://haji12345.github.io/Apicare-Farmers/',
		external: true,
		tag: 'In build · 2026',
		name: 'FarmLedger',
		desc: "AI traceability and credit-profile platform for the world's smallest farms. It records every trade a farmer makes with customers, businesses and FPOs, and multimodal AI turns that transaction history into a credit profile a bank can underwrite against.",
		stats: ['125+ farmers', 'MBA thesis project', 'Live prototype'],
		links: [{ href: 'https://haji12345.github.io/Apicare-Farmers/', label: 'Live prototype' }],
		media: [{ type: 'image' as const, src: farmledgerMark, alt: 'FarmLedger mark' }],
	},
	{
		href: '/tourism',
		external: false,
		tag: 'Independent Consultant · 2023 →',
		name: 'Tourism & Hospitality',
		desc: 'Websites, digital presence and content for homestays and retreats in the Eastern Himalaya, and social media for Hotel Poreč on the Adriatic.',
		stats: [`${tourismCount} projects`, 'Web design', 'Social media'],
		links: [{ href: '/tourism', label: 'See the projects' }],
		media: [
			{ type: 'video' as const, src: '/video/porec-istria-hilltop-town.mp4', poster: istriaHilltop, alt: 'Drone shot of a hilltop town in Istria, Croatia' },
			{ type: 'video' as const, src: '/video/kengbari-fresh-air.mp4', poster: kengbariFreshAir, alt: 'Kengbari Retreat, Gangtok' },
			{ type: 'image' as const, src: greenHamletAerial, alt: 'Aerial view of Green Hamlet, Gangtok' },
			{ type: 'image' as const, src: kunjhamPool, alt: 'Pool at Kunjham Retreat, Gangtok' },
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero wrap">
				<div class="hero-copy">
					<span class="eyebrow reveal">Programme delivery · Digital for development</span>
					<h1 class="display hero-title reveal">
						Building where the <span class="accent">rails</span> don't exist yet.
					</h1>
					<p class="lead reveal">
						Five years building ApiCare in Sikkim, working with 125+ smallholder farmers — selected by
						the Government of Sikkim as a private-sector partner under RAMP, a World Bank-financed MSME
						programme. Now building FarmLedger. Erasmus Mundus MBA in Impact Entrepreneurship.
					</p>
					<div class="hero-actions reveal">
						<a href="mailto:hello@nikhilpradhan.in" class="btn">Get in touch <span aria-hidden="true">↗</span></a>
						<a href="#work" class="link-arrow">View work <span aria-hidden="true">↓</span></a>
					</div>
				</div>

				<figure class="hero-media media-frame reveal">
					<Image src={heroImage} alt="Nikhil Pradhan, in a navy suit, standing against a brick wall" width={900} loading="eager" fetchpriority="high" />
					<figcaption class="hero-card">
						<span class="hero-card-label">Now</span>
						<span>Liège, Belgium · Graduating Dec 2026</span>
						<span class="hero-card-sub">English · Hindi · Nepali · French (A2) · Open to relocating</span>
					</figcaption>
				</figure>
			</section>

			<!-- STATS -->
			<section class="wrap" aria-label="Key numbers">
				<dl class="stats">
					{
						stats.map((s) => (
							<div class="stat">
								<dt>{s.label}</dt>
								<dd>{s.value}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<!-- WORK -->
			<section class="section wrap" id="work">
				<div class="section-head">
					<span class="eyebrow">Selected work</span>
					<div>
						<h2 class="h2">Ventures built on the ground.</h2>
						<p>Two interlocking ventures in Sikkim — the supply chain and the data layer that makes it bankable — plus hospitality work from the Himalaya to the Adriatic.</p>
					</div>
				</div>

				<div class="venture-grid">
					{
						ventures.map((v, i) => (
							<article class="venture">
								<MediaCarousel items={v.media} label={v.name} ratio="4 / 5" />
								<div class="venture-body">
									<div class="venture-top">
										<span class="venture-tag">{v.tag}</span>
									</div>
									<h3 class="venture-name">
										<a href={v.href} {...(v.external ? { target: '_blank', rel: 'noopener' } : {})}>
											{v.name} <span class="venture-arrow" aria-hidden="true">{v.external ? '↗' : '→'}</span>
										</a>
									</h3>
									<p class="venture-desc">{v.desc}</p>
									<ul class="venture-stats">
										{v.stats.map((s) => (
											<li>{s}</li>
										))}
									</ul>
									<div class="venture-links">
										{v.links.map((l) => (
											<a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
												{'instagram' in l && l.instagram && (
													<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
												)}
												{l.label}
											</a>
										))}
									</div>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- STATEMENT BAND -->
			<section class="band" aria-label="Approach">
				<div class="wrap band-inner">
					<h2 class="display band-title">
						Built in the field,<br /><span class="band-accent">not in a deck.</span>
					</h2>
					<div class="band-copy">
						<p>
							ApiCare was selected by the Government of Sikkim as a private-sector partner under RAMP, a
							World Bank-financed MSME programme: government counterparts, KPMG audit cycles, and
							training for smallholder farmers.
						</p>
						<p>
							That is the experience I'm bringing to programme management and digital-for-development
							roles.
						</p>
						<a href="/about" class="btn band-btn">More about me <span aria-hidden="true">→</span></a>
					</div>
				</div>
			</section>

			<!-- CASE STUDY PREVIEW -->
			{
				caseStudies.length > 0 && (
					<section class="case-preview section wrap" aria-labelledby="case-preview-title">
						<div class="case-preview-head">
							<div>
								<span class="eyebrow">Case study</span>
								<h2 id="case-preview-title" class="h2">The work behind the claims.</h2>
								<p>What the problem was, what I built, and what I learned in the field.</p>
							</div>
							<a href="/case-studies" class="btn case-preview-all">View all case studies <span aria-hidden="true">→</span></a>
						</div>

						{caseStudies.map((entry) => (
							<a href={`/case-studies/${entry.id}/`} class="case-preview-card">
								<span class="case-preview-number">01</span>
								<div class="case-preview-main">
									<span class="case-preview-meta">{entry.data.organisation} · {entry.data.period}</span>
									<h3>{entry.data.title}</h3>
									<p>{entry.data.summary}</p>
									<span class="case-preview-cta">Read the case study <span aria-hidden="true">↗</span></span>
								</div>
							</a>
						))}
					</section>
				)
			}

			<!-- CTA -->
			<section class="wrap cta-wrap" id="about">
				<div class="cta">
					<div>
						<span class="eyebrow cta-eyebrow">About</span>
						<h2 class="display cta-title">Let's talk.</h2>
						<p class="cta-text">
							I build operational infrastructure for places spreadsheets forgot. CEO of ApiCare since 2021,
							Erasmus Mundus MBA Fellow across Croatia, Lithuania, and Belgium, graduating December 2026.
						</p>
					</div>
					<div class="cta-actions">
						<a href="mailto:hello@nikhilpradhan.in" class="btn cta-btn">hello@nikhilpradhan.in <span aria-hidden="true">↗</span></a>
						<div class="cta-links">
							<a href="/about">Full bio</a>
							<a href="/cv.pdf">CV (PDF)</a>
							<a href="https://www.linkedin.com/in/nikhil-jabez-pradhan/" target="_blank" rel="noopener">LinkedIn</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* ===== HERO ===== */
	.hero {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: clamp(32px, 5vw, 72px);
		align-items: center;
		padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px);
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}
	.hero-title {
		font-size: clamp(48px, 7.2vw, 96px);
	}
	.hero-actions {
		display: flex;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}
	.hero-media {
		aspect-ratio: 4 / 5;
		box-shadow: var(--shadow);
	}
	/* Portrait photo: keep the face in frame whatever the crop, and leave
	   headroom above it so the top of the head is never clipped. */
	.hero-media :global(img) {
		object-position: 50% 18%;
	}
	.hero-card {
		position: absolute;
		left: 16px;
		right: 16px;
		bottom: 16px;
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 16px 18px;
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--bg-elev) 90%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		font-size: 15px;
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.hero-card-label {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.hero-card-sub {
		font-size: 13px;
		font-weight: 500;
		color: var(--ink-soft);
	}
	.reveal:nth-child(2) {
		animation-delay: 0.04s;
	}
	.reveal:nth-child(3) {
		animation-delay: 0.08s;
	}
	.reveal:nth-child(4) {
		animation-delay: 0.12s;
	}

	/* ===== STATS ===== */
	.stats {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 6px;
		padding: 28px 20px 28px 0;
	}
	.stat + .stat {
		padding-left: 20px;
		border-left: 1px solid var(--rule);
	}
	.stat dd {
		font-size: clamp(30px, 3.4vw, 44px);
		font-weight: 760;
		letter-spacing: -0.05em;
		line-height: 1;
	}
	.stat dt {
		font-size: 13px;
		color: var(--ink-soft);
		line-height: 1.35;
	}

	/* ===== VENTURES ===== */
	.venture-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(20px, 2.4vw, 28px);
	}
	.venture {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.venture-media {
		display: block;
		aspect-ratio: 4 / 5;
	}
	.venture-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s var(--ease);
	}
	.venture:hover .venture-media :global(img) {
		transform: scale(1.03);
	}
	.venture-placeholder {
		align-items: center;
		justify-content: center;
		text-align: center;
		font-size: clamp(22px, 2.6vw, 32px);
		line-height: 1.15;
		color: var(--ink);
	}
	.venture-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 0 4px;
	}
	.venture-top {
		display: flex;
		justify-content: space-between;
	}
	.venture-tag {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.venture-arrow {
		display: inline-block;
		font-size: 0.7em;
		vertical-align: 0.15em;
		transition: transform 0.2s var(--ease);
	}
	.venture:hover .venture-arrow {
		transform: translate(3px, -2px);
		color: var(--accent);
	}
	.venture-links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 18px;
		margin-top: 10px;
	}
	.venture-links a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		font-weight: 600;
		border-bottom: 1px solid var(--accent-fill);
	}
	.venture-name {
		font-size: clamp(26px, 2.4vw, 32px);
		font-weight: 740;
		letter-spacing: -0.045em;
		line-height: 1.05;
	}
	.venture-desc {
		color: var(--ink-soft);
		font-size: 16px;
		max-width: 520px;
	}
	.venture-stats {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 6px;
	}
	.venture-stats li {
		font-size: 12px;
		font-weight: 550;
		color: var(--ink-soft);
		border: 1px solid var(--rule);
		border-radius: 999px;
		padding: 3px 10px;
	}
	/* ===== CASE STUDY PREVIEW ===== */
	.case-preview {
		padding-block: clamp(72px, 9vw, 112px);
	}
	.case-preview-head {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 40px;
		padding-bottom: 40px;
		border-bottom: 1px solid var(--rule);
	}
	.case-preview-head p {
		margin-top: 12px;
		max-width: 560px;
		color: var(--ink-soft);
	}
	.case-preview-all {
		flex: 0 0 auto;
	}
	.case-preview-card {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		gap: 24px;
		padding: 48px 16px 12px;
		margin: 0 -16px;
		color: inherit;
		text-decoration: none;
	}
	.case-preview-card:hover {
		opacity: 1;
	}
	.case-preview-card:hover h3 {
		color: var(--accent);
	}
	.case-preview-card:hover .case-preview-cta {
		transform: translateX(4px);
	}
	.case-preview-number {
		font-family: var(--font-mono), monospace;
		font-size: 12px;
		letter-spacing: 0.05em;
		color: var(--accent);
		padding-top: 7px;
	}
	.case-preview-main {
		max-width: 920px;
	}
	.case-preview-meta {
		font-family: var(--font-mono), monospace;
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.case-preview-card h3 {
		font-family: var(--font-serif), Georgia, serif;
		font-size: clamp(28px, 4vw, 44px);
		line-height: 1.08;
		letter-spacing: -0.04em;
		margin: 12px 0 16px;
		max-width: 850px;
		transition: color 0.2s;
	}
	.case-preview-card p {
		max-width: 680px;
		font-size: 17px;
		line-height: 1.55;
		color: var(--ink-soft);
	}
	.case-preview-cta {
		display: inline-block;
		margin-top: 28px;
		font-size: 14px;
		font-weight: 650;
		border-bottom: 1px solid var(--accent-fill);
		transition: transform 0.2s var(--ease);
	}

	/* ===== BAND ===== */
	.band {
		background: var(--band-bg);
		color: var(--band-ink);
		padding-block: clamp(72px, 10vw, 128px);
	}
	.band-inner {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 40px 72px;
		align-items: end;
	}
	.band-title {
		font-size: clamp(40px, 6vw, 80px);
	}
	.band-accent {
		color: var(--accent-fill);
	}
	[data-theme='dark'] .band-accent {
		color: #9a5f00;
	}
	.band-copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
		font-size: 17px;
		color: color-mix(in srgb, var(--band-ink) 72%, transparent);
	}
	.band-btn {
		align-self: flex-start;
		margin-top: 8px;
		background: var(--band-ink);
		color: var(--band-bg);
		border-color: var(--band-ink);
	}

	/* ===== CTA ===== */
	.cta-wrap {
		padding-bottom: clamp(56px, 8vw, 96px);
	}
	.cta {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 32px 56px;
		align-items: end;
		padding: clamp(32px, 5vw, 64px);
		border-radius: var(--radius-lg);
		background: var(--accent-fill);
		color: var(--on-accent);
	}
	.cta-eyebrow {
		color: var(--on-accent);
	}
	.cta-eyebrow::before {
		background: var(--on-accent);
	}
	.cta-title {
		font-size: clamp(48px, 7vw, 96px);
		margin: 18px 0 20px;
	}
	.cta-text {
		font-size: 17px;
		max-width: 520px;
		color: rgba(17, 17, 15, 0.78);
	}
	.cta-actions {
		display: flex;
		flex-direction: column;
		gap: 20px;
		align-items: flex-start;
	}
	.cta-btn {
		background: #11110f;
		color: #f5f5f3;
		border-color: #11110f;
		max-width: 100%;
	}
	.cta-btn:hover {
		background: #fff;
		color: #11110f;
		border-color: #fff;
	}
	.cta-links {
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
		font-size: 14px;
		font-weight: 650;
	}
	.cta-links a {
		border-bottom: 1px solid rgba(17, 17, 15, 0.4);
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 960px) {
		.hero {
			grid-template-columns: 1fr;
		}
		.hero-media {
			/* A portrait photo in a landscape frame crops the head off — keep it
			   upright on tablets and phones, just a little less tall. */
			aspect-ratio: 4 / 5;
			width: min(100%, 420px);
			margin-inline: auto;
		}
		.stats {
			grid-template-columns: repeat(3, 1fr);
		}
		.stat:nth-child(4) {
			padding-left: 0;
			border-left: none;
		}
		.stat:nth-child(n + 4) {
			border-top: 1px solid var(--rule);
		}
		.band-inner,
		.cta {
			grid-template-columns: 1fr;
		}
		.case-preview-head {
			align-items: flex-start;
			flex-direction: column;
		}
		.venture-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.venture-media {
			aspect-ratio: 4 / 3;
		}
	}
	@media (max-width: 720px) {
		.venture-grid {
			grid-template-columns: 1fr;
		}
		.stats {
			grid-template-columns: repeat(2, 1fr);
