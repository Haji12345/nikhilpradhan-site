---
import { render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TourismCard from '../../components/tourism/TourismCard.astro';
import Gallery from '../../components/tourism/Gallery.astro';
import { SITE_TITLE } from '../../consts';
import { getTourismProjects } from '../../lib/work';
import { gallery } from '../../data/gallery';

const projects = await Promise.all(
	(await getTourismProjects()).map(async (project) => ({
		project,
		Content: project.body?.trim() ? (await render(project)).Content : null,
	})),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Tourism & hospitality — ${SITE_TITLE}`}
			description="Websites, digital presence and content for hospitality businesses, as an independent consultant and an Erasmus+ trainee."
		/>
	</head>
	<body>
		<Header />

		<main>
			<header class="page-head wrap">
				<span class="eyebrow reveal">Tourism &amp; hospitality</span>
				<h1 class="display page-title reveal">Helping places <span class="accent">tell their story.</span></h1>
				<p class="lead reveal">
					Websites, booking systems and content for homestays and retreats in the Eastern Himalaya, and
					for a hotel on the Adriatic coast.
				</p>
			</header>

			<section class="wrap" aria-label="Independent consulting">
				<div class="role">
					<div class="role-meta">
						<span class="eyebrow">Independent Consultant</span>
						<span class="role-when">Mar 2023 – Jul 2025</span>
					</div>
					<div>
						<h2 class="role-title">Digital Product Strategist &amp; Business Development Lead</h2>
						<p class="role-desc">
							Freelance work putting small hospitality businesses online and helping them find guests.
						</p>
						<ul class="role-points">
							<li>
								Took 4 hospitality businesses in India from no digital presence to a working setup: WordPress
								websites, the eZee channel manager, listings on booking sites (OTAs) and automated bookings.
							</li>
							<li>
								Ran their marketing through SEO, Meta Business Suite and Google Analytics. Together the
								content reached 3M+ views and 300K+ clicks across Instagram, Meta, the websites and OTA
								listings.
							</li>
							<li>
								Picked tools the owners could run themselves, with weak internet and no local tech support.
								The platforms are still live and maintained.
							</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section wrap" aria-label="Projects">
				<div class="t-grid">
					{
						projects.map(({ project, Content }) => (
							<TourismCard project={project}>{Content && <Content />}</TourismCard>
						))
					}
				</div>
			</section>

			{
				gallery.length > 0 && (
					<section class="section wrap" id="lens">
						<div class="section-head">
							<span class="eyebrow">Through the lens</span>
							<div>
								<h2 class="h2">Places I've photographed.</h2>
							</div>
						</div>
						<Gallery />
					</section>
				)
			}
		</main>

		<Footer />
	</body>
</html>

<style>
	.page-head {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding-block: clamp(56px, 8vw, 104px) clamp(40px, 6vw, 64px);
	}
	.page-title {
		font-size: clamp(44px, 6.5vw, 88px);
		max-width: 960px;
	}
	.role {
		display: grid;
		grid-template-columns: minmax(180px, 1fr) 3fr;
		gap: 24px 40px;
		padding: clamp(28px, 4vw, 44px);
		border-radius: var(--radius-lg);
		background: var(--bg-elev);
		border: 1px solid var(--rule);
	}
	.role-meta {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.role-when {
		font-size: 14px;
		color: var(--ink-soft);
	}
	.role-title {
		font-size: clamp(24px, 2.8vw, 34px);
		font-weight: 730;
		letter-spacing: -0.04em;
		line-height: 1.1;
		margin-bottom: 12px;
	}
	.role-desc,
	.role-points {
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink-soft);
	}
	.role-desc {
		margin-bottom: 14px;
	}
	.role-points {
		margin-left: 1.1em;
	}
	.role-points li {
		margin-bottom: 6px;
	}
	.t-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(32px, 4vw, 48px) clamp(20px, 2.4vw, 28px);
	}
	@media (max-width: 800px) {
		.role {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 960px) {
		.t-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 720px) {
		.t-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
